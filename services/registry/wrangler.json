{
  "$comment": "The Registry (ADR-041). The human deploys it to the production account (docs/DEPLOY.md §6) and puts the v0 signing key in the secret REGISTRY_SIGNING_KEY.",
  "name": "ludion-registry",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "registry.ludion.ai",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "RegistryState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RegistryState"
      ]
    }
  ],
  "vars": {
    "REGISTRY_ISSUER": "https://registry.ludion.ai",
    "REGISTRY_ORIGIN": "https://registry.ludion.ai"
  }
}
